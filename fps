-- ฟังก์ชันสร้างปุ่มเมนู
local function CreateButton(name, positionY)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(75, 40, 95)
    btn.Position = UDim2.new(0.1, 0, 0, positionY)
    btn.Size = UDim2.new(0.8, 0, 0, 45)
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(218, 112, 214)
    stroke.Transparency = 0.5
    stroke.Parent = btn

    -- ลูกเล่นกดแล้วเปลี่ยนสีนิดหน่อย
    btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(110, 55, 140)
    end)
    btn.MouseButton1Up:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(75, 40, 95)
    end)

    return btn
end

-- ================= ฟังก์ชันที่ 1: ปรับ FPS 90 =================
local Btn1 = CreateButton("⚡ ปรับ FPS 90 (ลื่นไหล)", 60)
Btn1.MouseButton1Click:Connect(function()
    pcall(function()
        setfpscap(90)
    end)
    Title.Text = "W FPS: บังคับ 90 FPS แล้ว"
    task.wait(2)
    Title.Text = "W FPS - Evade"
end)

-- ================= ฟังก์ชันที่ 2: กราฟฟิกต่ำสุด =================
local Btn2 = CreateButton("📉 กราฟฟิกต่ำสุด (แก้กระตุก)", 120)
Btn2.MouseButton1Click:Connect(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    Lighting.GlobalShadows = false
    Lighting.Brightness = 2
    
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1
        end
    end
    
    Title.Text = "W FPS: กราฟฟิกต่ำสุดแล้ว"
    task.wait(2)
    Title.Text = "W FPS - Evade"
end)

-- ================= ฟังก์ชันที่ 3: กราฟฟิกต่ำ V2 (ลบเอฟเฟกต์หนักๆ ออก) =================
local Btn3 = CreateButton("🧹 กราฟฟิกต่ำ V2 (ลบแลคขั้นสุด)", 180)
Btn3.MouseButton1Click:Connect(function()
    pcall(function()
        Lighting.FogEnd = 999999
        Lighting.Atmosphere:Destroy()
    end)
    
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
            v:Destroy()
        elseif v:IsA("PostEffect") then
            v.Enabled = false
        end
    end
    
    Title.Text = "W FPS: V2 เคลียร์ของหนักเรียบร้อย"
    task.wait(2)
    Title.Text = "W FPS - Evade"
end)
